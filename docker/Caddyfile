# Caddy — gerbang tunggal LENTERA BPOM Jember.
#
# Hanya service ini yang membuka port 80/443. Sertifikat TLS diurus otomatis
# oleh Caddy (Let's Encrypt / ZeroSSL) selama {$DOMAIN} benar-benar mengarah
# ke IP VPS ini.
#
# Pembagian rute:
#   /api/*, /storage/*, /sanctum/*, /up  → Laravel  (container `api`, port 8000)
#   sisanya                              → Next.js  (container `web`, port 3000)
#
# Berkas ini adalah TITIK AWAL untuk pemasangan baru, bukan salinan konfigurasi
# VPS yang sedang berjalan. Satu Caddy bisa melayani beberapa aplikasi sekaligus;
# di VPS produksi berkas ini memuat blok situs lain yang tidak ada di repositori
# ini. Karena itu `scripts/buat-rilis.sh` sengaja TIDAK menyertakannya ke dalam
# paket rilis — agar mengekstrak rilis tidak pernah menimpa penyetelan manual.
#
# Bila menyalin berkas ini ke VPS yang sudah punya Caddyfile sendiri:
#   cp docker/Caddyfile docker/Caddyfile.vps.bak    # cadangkan dulu
#   diff docker/Caddyfile.vps.bak docker/Caddyfile  # bandingkan
# lalu gabungkan — jangan timpa begitu saja.
#
# Admin API Caddy sengaja TIDAK dimatikan di sini: pada VPS yang Caddy-nya
# dipakai bersama aplikasi lain, `caddy reload` membutuhkannya.

{$DOMAIN} {
	encode zstd gzip

	# Unggahan berkas (BAST, lampiran arsip, impor Excel) bisa beberapa MB.
	request_body {
		max_size 25MB
	}

	# Backend Laravel: REST API, berkas publik storage, dan endpoint kesehatan.
	@backend path /api/* /storage/* /sanctum/* /up
	handle @backend {
		reverse_proxy api:8000
	}

	# Selebihnya adalah aplikasi web Next.js.
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
