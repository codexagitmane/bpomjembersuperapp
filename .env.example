# Variabel untuk docker-compose (bukan untuk apps/api atau apps/web — masing-masing
# punya .env sendiri saat dijalankan secara native/non-docker).

# Generate dengan: cd apps/api && php artisan key:generate --show
APP_KEY=

DB_DATABASE=bpom_jember
DB_USERNAME=bpom
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret
